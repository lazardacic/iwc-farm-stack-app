# Used by docker-compose.prod.yml. Copy to .env (git-ignored) and fill in.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_URL=http://localhost:8080
APP_PORT=8080

# "local" keeps uploads in the media volume; "cloudinary" needs the three keys below.
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
