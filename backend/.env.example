# Local development only. Replace this with a unique secret before deployment.
JWT_SECRET=change-this-local-development-secret-to-a-random-value
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=farm_db
CORS_ORIGINS=http://localhost:5173

# Image uploads: "local" (default, files in backend/media) or "cloudinary".
IMAGE_STORAGE=local
API_PUBLIC_URL=http://localhost:8000
# Required only when IMAGE_STORAGE=cloudinary. Keep these secrets out of git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
